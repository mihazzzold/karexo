# ─────────────────────────────────────────────────────────────────────────────
#  karexo - настройки установки
# ─────────────────────────────────────────────────────────────────────────────
#  Скопируйте этот файл рядом с docker-compose.yml под именем .env:
#     cp .env.example .env
#  и заполните значения. docker compose прочитает его при запуске.
#
#  ⚠️ В .env попадает пароль от почтового ящика - не выкладывайте его в открытый
#  доступ и не добавляйте в git.
#  Все переменные необязательные: karexo запустится и с пустым файлом.
# ─────────────────────────────────────────────────────────────────────────────


# ── Адрес и порт ─────────────────────────────────────────────────────────────

# Порт, на котором karexo будет доступен на вашем сервере.
# Внутри контейнера сервер всегда слушает 8080 - здесь меняется только внешний
# порт. Занят 8080? Поставьте любой свободный, например 8095.
# Если впереди стоит обратный прокси (nginx, Caddy), укажите этот же порт в его
# конфиге: прокси стучится на 127.0.0.1:<этот порт>.
KAREXO_PORT=8080

# Публичный адрес инстанса - тот самый, по которому вы открываете karexo
# в браузере. Из него собираются ссылки в письмах: приглашение в документ
# и отписка от еженедельного дайджеста.
# Пусто - письма уйдут без ссылок (доступ по приглашению всё равно выдастся
# после регистрации адресата).
# Примеры: http://192.168.1.50:8080  |  https://karexo.example.com
KAREXO_BASE_URL=


# ── Почта (SMTP) ─────────────────────────────────────────────────────────────
# Нужна для четырёх писем: код подтверждения почты, код сброса пароля,
# приглашение в документ и еженедельный дайджест.
#
# Оставьте KAREXO_SMTP_HOST пустым - письма отправляться не будут, а коды
# появятся в логе контейнера (docker compose logs karexo). Для установки
# «для себя» этого достаточно.

# Адрес почтового сервера. Пример: smtp.yandex.ru, smtp.gmail.com
KAREXO_SMTP_HOST=

# Порт почтового сервера:
#   587 - обычный порт, шифрование включается командой STARTTLS
#   465 - соединение шифруется сразу
# Пусто - используется 587.
KAREXO_SMTP_PORT=587

# Логин и пароль почтового ящика, от имени которого уходят письма.
# Пустой логин - отправка без авторизации (так работают внутренние релеи в сети
# организации). Если логин задан, а сервер авторизацию не предлагает, письмо не
# уйдёт, а в логе появится строка «сервер не поддерживает AUTH».
KAREXO_SMTP_USER=
KAREXO_SMTP_PASS=

# Адрес в поле «От кого». Пусто - подставится значение KAREXO_SMTP_USER.
# Многие почтовые провайдеры требуют, чтобы этот адрес совпадал с логином.
KAREXO_SMTP_FROM=


# ── Уже настроено внутри образа - менять не нужно ─────────────────────────────
#   KAREXO_ADDR=:8080     - адрес и порт, который слушает сервер в контейнере
#   KAREXO_DATA=/data     - каталог данных (том karexo-data), файл базы karexo.db
#   KAREXO_WEB=/srv/web   - где внутри контейнера лежит само приложение
