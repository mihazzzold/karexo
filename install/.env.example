# karexo - настройки инстанса.
#
# Скопируйте в .env рядом и заполните. Пустая строка = поведение по умолчанию,
# поэтому заполнять надо только то, что вам нужно.
#
#   cp .env.example .env
#
# ⚠️ .env содержит пароль от почты и ключ шифрования - не кладите его в git и
# не давайте читать кому попало.

# ─────────────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНОЕ - без этих двух строк инстанс не запустится
# ─────────────────────────────────────────────────────────────────────────────

# Адрес, по которому karexo открывают из браузера. Уходит в письма и публичные
# ссылки. С протоколом, без слэша в конце.
KAREXO_BASE_URL=https://notes.example.org

# Ключ шифрования токенов интеграций. Сгенерируйте ОДИН раз и сохраните:
#   openssl rand -hex 32
# Смена ключа делает уже сохранённые токены нечитаемыми - интеграции придётся
# подключать заново.
KAREXO_TOKEN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Порт и версия
# ─────────────────────────────────────────────────────────────────────────────

# Порт на вашей машине. За обратным прокси удобнее 127.0.0.1:8080 - тогда
# наружу торчит только прокси (правьте тогда сам docker-compose.yml).
KAREXO_PORT=8080

# Какую версию ставить. Сейчас последний выпуск предварительный, поэтому тега
# latest нет намеренно: иначе бета уезжала бы всем, кто выполнил pull.
# Список версий - на странице выпусков репозитория karexo.
KAREXO_TAG=v0.2.0-beta.1

# ─────────────────────────────────────────────────────────────────────────────
# Кто может завести аккаунт
# ─────────────────────────────────────────────────────────────────────────────

# open   - регистрируется любой, кто открыл адрес
# invite - только по приглашению от участника (по умолчанию)
# closed - аккаунты заводит администратор в разделе «Сервер»
KAREXO_REGISTRATION=invite

# self-hosted (по умолчанию) | enterprise
# enterprise разом включает: наружу не ходим, регистрация по приглашению,
# строгий CSP.
KAREXO_EDITION=self-hosted

# ─────────────────────────────────────────────────────────────────────────────
# Почта - без неё не уходят коды входа и приглашения
# ─────────────────────────────────────────────────────────────────────────────

KAREXO_SMTP_HOST=
KAREXO_SMTP_PORT=587
KAREXO_SMTP_USER=
KAREXO_SMTP_PASS=
# От кого приходят письма. Обычно требуется адрес на том же домене, что и SMTP.
KAREXO_SMTP_FROM=karexo@example.org

# ─────────────────────────────────────────────────────────────────────────────
# HTTPS
# ─────────────────────────────────────────────────────────────────────────────

# off  - обычный HTTP (по умолчанию). Берите, если перед karexo стоит nginx,
#        traefik или Caddy - шифрование обеспечивает он.
# auto - karexo сам получает сертификат Let's Encrypt. Нужны публичный домен и
#        порты 80 и 443, доступные снаружи: по 80 идёт проверка владения.
#        ⚠️ В закрытом контуре недоступен - это обращение к чужому серверу.
#           Инстанс откажется стартовать и скажет об этом прямо.
# file - свой сертификат: своего центра сертификации, wildcard, любой. Наружу
#        не ходим совсем.
KAREXO_TLS=off

# Имя (или несколько через запятую), на которое берётся сертификат в режиме auto.
# Только имя: без https:// и без порта.
KAREXO_TLS_DOMAIN=

# Куда Let's Encrypt напишет, если сертификат перестанет обновляться.
# Необязательно, но без него о поломке узнаете от пользователей.
KAREXO_TLS_EMAIL=

# Свой сертификат для режима file. В CERT кладите цепочку целиком.
KAREXO_TLS_CERT=
KAREXO_TLS_KEY=

# Порт HTTPS. Пусто = :443. Порт из KAREXO_PORT остаётся под HTTP: там живут
# редирект на https и проверка владения доменом.
KAREXO_TLS_ADDR=

# Где хранить полученные сертификаты. Пусто = <данные>/certs, то есть внутри
# тома - так они переживают перезапуск. Свой ACME-сервер (внутренний центр
# сертификации) задаётся отдельной строкой.
KAREXO_TLS_CACHE=
KAREXO_TLS_DIRECTORY=

# ─────────────────────────────────────────────────────────────────────────────
# Обратный прокси
# ─────────────────────────────────────────────────────────────────────────────

# true - TLS терминирует nginx/traefik/Caddy перед нами, и он проставляет
# X-Forwarded-Proto. Тогда сессионная кука получает флаг Secure.
#
# ⚠️ НЕ включайте, если сервер смотрит в интернет напрямую: заголовок присылает
# клиент, и подделав его, он заставит куку уехать по открытому каналу.
KAREXO_TRUST_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# Место на диске
# ─────────────────────────────────────────────────────────────────────────────

# Потолок на весь инстанс, байты. Пусто = сколько влезет на диск.
KAREXO_INSTANCE_LIMIT=

# Сколько байт в месяц можно раздать по ПУБЛИЧНЫМ ссылкам. Защита от случая
# «страница с видео попала в чужой чат». Пусто = без предела.
KAREXO_EGRESS_MONTHLY_BYTES=

# ─────────────────────────────────────────────────────────────────────────────
# Резервные копии по расписанию
# ─────────────────────────────────────────────────────────────────────────────

# Выключены, пока не заданы обе строки. Путь должен быть внутри тома /data,
# иначе копии исчезнут вместе с контейнером.
KAREXO_BACKUP_DIR=
# Как часто: 24h, 12h, 168h
KAREXO_BACKUP_EVERY=
# Сколько копий держать (старые удаляются)
KAREXO_BACKUP_KEEP=7

# ─────────────────────────────────────────────────────────────────────────────
# Интеграции
# ─────────────────────────────────────────────────────────────────────────────

# false - раздел «Интеграции» выключен целиком.
KAREXO_FEATURES_INTEGRATIONS=

# Ключи заводятся в самом провайдере, адрес возврата - ваш KAREXO_BASE_URL:
#   GitHub: Settings → Developer settings → OAuth Apps
#           callback: <KAREXO_BASE_URL>/api/integrations/github/callback
KAREXO_GITHUB_CLIENT_ID=
KAREXO_GITHUB_CLIENT_SECRET=
KAREXO_GOOGLE_CLIENT_ID=
KAREXO_GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Лицензия
# ─────────────────────────────────────────────────────────────────────────────

# Ключ платной редакции: сам ключ строкой либо путь к файлу с ним.
# Проверяется ОФФЛАЙН - обращений наружу нет, в закрытом контуре работает так же.
# Пусто = бесплатная установка (self-hosted), всё основное доступно.
KAREXO_LICENSE=

# true - без действующего ключа инстанс не запустится вовсе.
# По умолчанию мягко: расхождение видно в логе и в /api/policy, работа идёт.
KAREXO_LICENSE_ENFORCE=

# ─────────────────────────────────────────────────────────────────────────────
# Закрытый контур
# ─────────────────────────────────────────────────────────────────────────────

# false - сервер не обращается ни к одному внешнему адресу. То же самое даёт
# KAREXO_EDITION=enterprise. Проверить, в каком режиме инстанс поднялся:
#   curl <KAREXO_BASE_URL>/api/policy
KAREXO_ALLOW_OUTBOUND=

# Свои адреса вместо публичных: GitHub Enterprise Server на вашем домене,
# Slack и Telegram через внутренний прокси. Пусто = обычные адреса.
KAREXO_GITHUB_AUTH_HOST=
KAREXO_GITHUB_API_HOST=
KAREXO_SLACK_HOOK_HOST=
KAREXO_TELEGRAM_API_HOST=
