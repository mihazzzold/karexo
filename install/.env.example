# karexo - настройки инстанса.
#
# Скопируйте в .env рядом и заполните. Пустая строка = поведение по умолчанию,
# поэтому заполнять надо только то, что вам нужно.
#
#   cp .env.example .env
#
# ⚠️ .env содержит пароль от почты и ключ шифрования - не кладите его в git и
# не давайте читать кому попало.

# ─────────────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНОЕ - без этих двух строк инстанс не запустится
# ─────────────────────────────────────────────────────────────────────────────

# Адрес, по которому karexo открывают из браузера. Уходит в письма и публичные
# ссылки. С протоколом, без слэша в конце.
KAREXO_BASE_URL=https://notes.example.org

# Коннектор claude.ai (необязательно). Адрес моста MCP; пусто = коннектор
# выключен (/mcp и /oauth/* отвечают 404). Нужен публичный https-адрес выше,
# видимый из интернета. В claude.ai вставляется один адрес: <KAREXO_BASE_URL>/mcp.
# Пример: KAREXO_MCP_UPSTREAM=http://karexo-mcp:3000
KAREXO_MCP_UPSTREAM=

# Ключ шифрования токенов интеграций. Сгенерируйте ОДИН раз и сохраните:
#   openssl rand -hex 32
# Смена ключа делает уже сохранённые токены нечитаемыми - интеграции придётся
# подключать заново.
KAREXO_TOKEN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Порт и версия
# ─────────────────────────────────────────────────────────────────────────────

# Порт на вашей машине. За обратным прокси удобнее 127.0.0.1:8080 - тогда
# наружу торчит только прокси (правьте тогда сам docker-compose.yml).
KAREXO_PORT=8080

# Какую версию ставить. latest - окончательный выпуск (CI не пускает в latest
# теги с дефисом, то есть beta/rc). Нужна конкретная версия - впишите точный
# тег со страницы выпусков репозитория karexo.
KAREXO_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Кто может завести аккаунт
# ─────────────────────────────────────────────────────────────────────────────

# open   - регистрируется любой, кто открыл адрес
# invite - только по приглашению от участника (по умолчанию)
# closed - аккаунты заводит администратор в разделе «Сервер»
#
# ⚠️ При invite и closed формы «Зарегистрироваться» на инстансе НЕТ вовсе, и
# первый вход сам собой не появится: приглашать некому, база пустая. Владельца
# заводят отдельной командой сразу после `docker compose up -d`:
#
#   printf '%s\n' 'пароль-не-короче-8' | docker compose exec -T karexo \
#       karexo-server -create-owner -data /data -owner-email you@example.org
#
# install.sh спрашивает эту учётку сам и зовёт ту же команду. Пароль идёт в
# stdin, а не флагом: аргументы видны в `ps` и в `docker inspect`.
KAREXO_REGISTRATION=invite

# self-hosted (по умолчанию) | enterprise
# enterprise разом включает: наружу не ходим, регистрация по приглашению,
# строгий CSP.
KAREXO_EDITION=self-hosted

# personal | team - что такое «пространство» на этом инстансе.
# personal: вошедшие друг другу посторонние, «открыть всем участникам инстанса»
#           сервер запрещает, кнопки в интерфейсе нет.
# team:     вошедшие - коллеги, общий блокнот инстанса работает.
# Пусто = выводится из редакции: self-hosted и enterprise - team.
# Ставить personal есть смысл там, где на одном инстансе живут не коллеги:
# семья, клуб, хостинг заметок для клиентов.
KAREXO_WORKSPACE=

# ─────────────────────────────────────────────────────────────────────────────
# Почта - без неё не уходят коды входа и приглашения
# ─────────────────────────────────────────────────────────────────────────────

KAREXO_SMTP_HOST=
KAREXO_SMTP_PORT=587
KAREXO_SMTP_USER=
KAREXO_SMTP_PASS=
# От кого приходят письма. Обычно требуется адрес на том же домене, что и SMTP.
KAREXO_SMTP_FROM=karexo@example.org

# ─────────────────────────────────────────────────────────────────────────────
# HTTPS
# ─────────────────────────────────────────────────────────────────────────────

# off  - обычный HTTP (по умолчанию). Берите, если перед karexo стоит nginx,
#        traefik или Caddy - шифрование обеспечивает он.
# auto - karexo сам получает сертификат Let's Encrypt. Нужны публичный домен и
#        порты 80 и 443, доступные снаружи: по 80 идёт проверка владения.
#        ⚠️ В закрытом контуре недоступен - это обращение к чужому серверу.
#           Инстанс откажется стартовать и скажет об этом прямо.
# file - свой сертификат: своего центра сертификации, wildcard, любой. Наружу
#        не ходим совсем.
KAREXO_TLS=off

# Имя (или несколько через запятую), на которое берётся сертификат в режиме auto.
# Только имя: без https:// и без порта.
KAREXO_TLS_DOMAIN=

# Куда Let's Encrypt напишет, если сертификат перестанет обновляться.
# Необязательно, но без него о поломке узнаете от пользователей.
KAREXO_TLS_EMAIL=

# Свой сертификат для режима file. В CERT кладите цепочку целиком.
KAREXO_TLS_CERT=
KAREXO_TLS_KEY=

# Порт HTTPS. Пусто = :443. Порт из KAREXO_PORT остаётся под HTTP: там живут
# редирект на https и проверка владения доменом.
KAREXO_TLS_ADDR=

# Где хранить полученные сертификаты. Пусто = <данные>/certs, то есть внутри
# тома - так они переживают перезапуск. Свой ACME-сервер (внутренний центр
# сертификации) задаётся отдельной строкой.
KAREXO_TLS_CACHE=
KAREXO_TLS_DIRECTORY=

# ─────────────────────────────────────────────────────────────────────────────
# Логирование
# ─────────────────────────────────────────────────────────────────────────────

# Путь к файлу лога. Пусто = только stdout (docker logs), как было раньше.
# Заданный путь получает те же записи ещё и построчным JSON - машиночитаемо,
# для будущей консоли (E5/E6). Файл открывается на дозапись, права 0600.
KAREXO_LOG_FILE=
# debug · info · warn · error. Пусто = info. Нераспознанное значение молча
# читается как info - опечатка не роняет инстанс.
KAREXO_LOG_LEVEL=

# ─────────────────────────────────────────────────────────────────────────────
# Обратный прокси
# ─────────────────────────────────────────────────────────────────────────────

# true - TLS терминирует nginx/traefik/Caddy перед нами, и он проставляет
# X-Forwarded-Proto. Тогда сессионная кука получает флаг Secure.
#
# ⚠️ НЕ включайте, если сервер смотрит в интернет напрямую: заголовок присылает
# клиент, и подделав его, он заставит куку уехать по открытому каналу.
KAREXO_TRUST_PROXY=

# Сколько прокси стоит перед сервером (только вместе с KAREXO_TRUST_PROXY).
# Пусто = 1. Адрес клиента берётся из X-Forwarded-For С КОНЦА, элементом под
# этим номером. Прокси бывает дописывающим ($proxy_add_x_forwarded_for - в хвост
# ложится адрес, который он видел, а в начале остаётся присланное клиентом) и
# перезаписывающим (остаётся один элемент): при 1 подходят оба. Поставьте 2,
# если перед вашим прокси стоит ещё один (например Cloudflare перед nginx).
# ⚠️ НЕВЕРНОЕ число ломает лимиты: слишком малое - все люди окажутся одним
# адресом (адресом прокси), слишком большое - адрес снова можно подделать.
KAREXO_TRUSTED_PROXY_HOPS=

# Дополнительные Origin, с которых браузер может открыть сокет синка, через
# запятую: https://notes.example.org,https://wiki.example.org:8443. Нужен, только
# если интерфейс открывают по ДРУГОМУ имени, чем то, что прокси передаёт серверу
# в Host, и это имя не совпадает с KAREXO_BASE_URL. Свой адрес и адрес из
# KAREXO_BASE_URL пускаются и без списка. Сравнение точное (схема, хост, порт),
# без пути. Пусто = только свои. Чужие страницы сокет не откроют ни в какой
# редакции.
KAREXO_WS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Место на диске
# ─────────────────────────────────────────────────────────────────────────────

# Потолок на весь инстанс, байты. Пусто = сколько влезет на диск.
KAREXO_INSTANCE_LIMIT=
# Предел размера ОДНОГО вложения (можно с суффиксом: 10M). Пусто = 25 МиБ.
# ⚠️ Ноль здесь НЕ снимает предел, в отличие от KAREXO_INSTANCE_LIMIT выше: он
# означает «не назначено», и действует умолчание 25 МиБ.
# Больше 25 МиБ вписать можно, но действовать будет 25: при E2E браузер
# шифрует вложение целиком в памяти. В облаке число назначает тариф, и он
# сильнее: эта переменная работает там, где тариф числа не назвал.
KAREXO_BLOB_MAX_SIZE=
# Ежесуточная уборка вложений БЕЗ ссылок старше 7 суток (загрузили, а блока со
# ссылкой так и не появилось). E2E-документы не трогает: сервер не видит там
# ссылок. Пусто = включена; 0 = выключить.
KAREXO_BLOB_GC=
# Уборка ЗАШИФРОВАННЫХ вложений по заявлению клиента (раз в сутки браузер с открытым
# сейфом присылает список живых id; стираем старше 7 суток, вне свежего полного
# заявления, не больше 20% за заявление). Только при включённой KAREXO_BLOB_GC.
# Пусто = включена; 0 = выключить (зашифрованное не трогается).
KAREXO_BLOB_GC_E2E=
# Отдельный журнал комментариев E2E-страниц: комментарии живут не в op-логе
# страницы, а в своём журнале с раздельными правами (комментатор пишет только в
# свой раздел). Испытательный стенд: клиент журнала в редактор ещё не подключён,
# поэтому на обычном инстансе флаг ничего не меняет.
# Пусто = выключен; 1 = включить серверные сценарии журнала.
KAREXO_EXPERIMENTAL_COMMENT_JOURNAL=
# Уплотнение op-логов открытых документов на сервере (раз в 6 часов, история версий
# и итог те же, выброшенное 30 суток в архиве, E2E не трогается).
# Пусто = включено; 0 = выключить.
KAREXO_OPLOG_COMPACT=

# Сколько байт в месяц можно раздать по ПУБЛИЧНЫМ ссылкам. Защита от случая
# «страница с видео попала в чужой чат». Пусто = без предела.
KAREXO_EGRESS_MONTHLY_BYTES=

# ─────────────────────────────────────────────────────────────────────────────
# Резервные копии по расписанию
# ─────────────────────────────────────────────────────────────────────────────

# Выключены, пока не заданы обе строки. Путь должен быть внутри тома /data,
# иначе копии исчезнут вместе с контейнером.
KAREXO_BACKUP_DIR=
# Как часто: 24h, 12h, 168h
KAREXO_BACKUP_EVERY=
# Сколько копий держать (старые удаляются)
KAREXO_BACKUP_KEEP=7

# ─────────────────────────────────────────────────────────────────────────────
# Интеграции
# ─────────────────────────────────────────────────────────────────────────────

# false - раздел «Интеграции» выключен целиком.
KAREXO_FEATURES_INTEGRATIONS=

# Синк страниц с GitLab: 1 - пускать сервер к GitLab во внутренней сети
# (свой GitLab в контуре компании). Пусто - только публичные адреса.
# В облаке (saas) не действует никогда. Только https, без переадресаций.
KAREXO_GITLAB_ALLOW_PRIVATE=
# Потолок операций синка с GitLab на аккаунт в окно (пусто = 1200 в 3600 с).
KAREXO_GITLAB_CALL_MAX=
KAREXO_GITLAB_CALL_WINDOW_SEC=
# «Подключить через GitLab» (OAuth, только gitlab.com): ключи приложения с
# gitlab.com (User Settings → Applications или Group → Settings → Applications;
# Redirect URI <KAREXO_BASE_URL>/api/integrations/gitlab/oauth/callback,
# Confidential, scope api). Пусто - кнопки нет, остаётся ручной токен.
# Нужен KAREXO_BASE_URL. Секрет - только здесь, в git не класть.
KAREXO_GITLAB_OAUTH_CLIENT_ID=
KAREXO_GITLAB_OAUTH_CLIENT_SECRET=

# Сквозное шифрование (E2E): бывает ли оно на этом инстансе.
# Пусто = умолчание редакции: self-hosted и enterprise - бывает, saas - нет
# (решение владельца 05.09.2026). Где выключено, сейф не заводится и экраны
# парольной фразы не показываются; уже зашифрованное читается и расшифровывается
# из настроек. Гашение интерфейса, а не замок - сервер шифртекст от открытого
# текста не отличает.
KAREXO_FEATURES_E2E=

# Сломанное подключение календаря перестают дёргать: столько отказов подряд -
# и на столько секунд замолкаем. Пусто = 5 и 600.
#
# Очередь во вкладке повторяет неудавшуюся правку (иначе она терялась бы при
# обрыве связи), и без этого стопа пара «очередь повторяет - сервер передаёт»
# долбит чужой календарь до блокировки аккаунта на той стороне.
KAREXO_CALENDAR_WRITE_FAILS=
KAREXO_CALENDAR_WRITE_PAUSE_SEC=

# Ключи заводятся в самом провайдере. Адреса возврата собираются из вашего
# KAREXO_BASE_URL, и вписать у провайдера надо ВСЕ из списка: без адресов
# привязки и подтверждения сам вход работает, а «Привязать …» и «Подтвердить
# через …» в настройках аккаунта ломаются. Кнопка появится только после
# `docker compose up -d` (не restart).
#
#   GitHub: Settings → Developer settings → OAuth Apps → New OAuth App.
#           Authorization callback URL - адрес входа ПЕРВЫМ, остальные кнопкой
#           «Add callback URL»; когда все четыре вписаны, сопоставление по
#           подкаталогу (wildcard) у каждого выключить:
#             <KAREXO_BASE_URL>/api/auth/oauth/github/callback
#             <KAREXO_BASE_URL>/api/auth/links/github/callback
#             <KAREXO_BASE_URL>/api/auth/reauth/github/callback
#             <KAREXO_BASE_URL>/api/integrations/github/callback
KAREXO_GITHUB_CLIENT_ID=
KAREXO_GITHUB_CLIENT_SECRET=
#   Google: консоль Google Cloud → Google Auth Platform → Clients → Create
#           client → Web application → Authorized redirect URIs (сверяются
#           посимвольно; только https, кроме localhost):
#             <KAREXO_BASE_URL>/api/auth/oauth/google/callback
#             <KAREXO_BASE_URL>/api/auth/links/google/callback
#             <KAREXO_BASE_URL>/api/auth/reauth/google/callback
#             <KAREXO_BASE_URL>/api/integrations/google/callback
#           Вход просит openid email profile. Календарь - ещё calendar.readonly
#           и calendar.events (запись): это чувствительные права. В статусе
#           Testing календарь подключат только тестовые пользователи, а
#           публичному инстансу с календарём нужна проверка приложения у Google.
KAREXO_GOOGLE_CLIENT_ID=
KAREXO_GOOGLE_CLIENT_SECRET=
#   Яндекс: oauth.yandex.ru → «Создать приложение» → «Для авторизации
#           пользователей», платформа «Веб-сервисы». Доступ к данным - ровно
#           «Адрес электронной почты» и «Логин, имя и фамилия, пол».
#           Redirect URI - адрес входа ПЕРВЫМ (при неточном совпадении Яндекс
#           молча берёт первый из списка):
#             <KAREXO_BASE_URL>/api/auth/oauth/yandex/callback
#             <KAREXO_BASE_URL>/api/auth/links/yandex/callback
#             <KAREXO_BASE_URL>/api/auth/reauth/yandex/callback
#   Яндекс даёт ТОЛЬКО вход - подключать по нему нечего. Новые аккаунты через
#   него заводятся с неподтверждённым адресом и письмом с кодом, поэтому нужна
#   почта (SMTP). Оставьте пусто, если кнопка «Продолжить через Яндекс» вам не
#   нужна: это настройка, а не поломка.
KAREXO_YANDEX_CLIENT_ID=
KAREXO_YANDEX_CLIENT_SECRET=

# Потолок НАЧАЛА привязки способа входа в настройках аккаунта: столько попыток
# на аккаунт за столько секунд. Пусто = 10 и 300 - ровно как у второго фактора.
#
# Не тот же потолок, что у кнопки «Продолжить через Google» (KAREXO_OAUTH_SIGNIN_MAX):
# там мерка широкая, потому что за одним адресом сидит целый офис, а привязка
# СПРАШИВАЕТ ПАРОЛЬ - под широкой меркой угнанная сессия подбирала бы его
# сутками. 0 снимает потолок совсем.
KAREXO_OAUTH_LINK_MAX=
KAREXO_OAUTH_LINK_WINDOW_SEC=

# Потолок обращений в поддержку: столько заявок на аккаунт за столько секунд.
# Пусто = 5 и 3600 - пять заявок в час на человека. Ключ - аккаунт: это
# авторизованное действие, счёт по адресу дал бы офису за общим NAT мешать
# друг другу.
KAREXO_FEEDBACK_MAX=
KAREXO_FEEDBACK_WINDOW_SEC=

# Потолок реплик в уже заведённой теме обращения (и автора, и поддержки):
# столько сообщений на аккаунт за столько секунд. Пусто = 30 и 3600. Счётчик
# свой, не общий с новыми темами: живой разговор с поддержкой не должен
# упираться в потолок заведения тем. 0 снимает потолок совсем.
KAREXO_FEEDBACK_REPLY_MAX=
KAREXO_FEEDBACK_REPLY_WINDOW_SEC=

# Форма «Написать нам» для человека БЕЗ аккаунта (экран входа и гостевой
# просмотр). Пусто = включено во всех редакциях. false - обработчик отвечает 404
# любому запросу, который до него дошёл (чужая страница получает 403 раньше, а
# частящий адрес - 429), кнопки в интерфейсе прячутся; принятое администратор по-
# прежнему читает и удаляет в «Поддержке». Ручка открыта миру, поэтому держится
# потолками: с одного адреса - 3 в час и 10 в сутки (за обратным прокси нужен
# KAREXO_TRUST_PROXY=true, иначе все гости делят адрес прокси), на весь инстанс -
# 200 в сутки, хранится 2000 последних. 0 в любом потолке снимает его.
KAREXO_PUBLIC_FEEDBACK=
KAREXO_PUBLIC_FEEDBACK_HOUR_MAX=
KAREXO_PUBLIC_FEEDBACK_DAY_MAX=
KAREXO_PUBLIC_FEEDBACK_INSTANCE_DAY_MAX=
KAREXO_PUBLIC_FEEDBACK_KEEP=
# Курсоры коллег в общем документе (кадр `cur` в /api/sync, «Присутствие»).
# Пусто = из редакции: в облаке (saas) включено, в self-hosted и enterprise выключено.
# on/off перебивает в обе стороны. При выключенных сервер кадры `cur` игнорирует.
# ⚠️ Включая, помните: сервер и коллеги видят, кто сейчас на какой странице и у какого
# блока. Для зашифрованных (E2E) документов курсоры гасит клиент - сервер их не отличает.
KAREXO_PRESENCE_CURSORS=
# Предпросмотр ссылок (заголовок и картинка блока-закладки; сервер идёт по адресу из
# документа - docs/egress.md, S1): УМОЛЧАНИЕ тумблера у человека, который его не трогал.
# Пусто = из редакции: в облаке (saas) включено, в self-hosted и enterprise выключено.
# on/off перебивает в обе стороны; явный выбор человека в настройках сильнее. При
# KAREXO_ALLOW_OUTBOUND=false выключено всегда, а ручка превью отвечает 403.
KAREXO_LINK_PREVIEW_DEFAULT=
# Запись во ВНЕШНИЕ календари (CalDAV, Google): правка и снятие встречи из строки базы и
# поимённая выдача права писать в свой календарь. Пусто = из редакции: в облаке (saas)
# выключено (заморожено, P6-02), в self-hosted и enterprise включено. on/off перебивает в обе
# стороны. При выключенной записи ручки записи и выдачи отвечают 403
# integration.calendar_write_disabled; чтение и импорт календарей работают как раньше.
KAREXO_FEATURES_CALENDAR_WRITE=
# Заморозка X-47 (решение P2-61): три группы, лежавшие в живом пути облака без своего
# выключателя. У каждой пусто = из редакции: в облаке (saas) выключено, в self-hosted и
# enterprise включено, как было. on/off перебивает в обе стороны.
# Командный ИИ: участник тратит кредиты владельца команды. off - ручки /api/team/ai
# отвечают 404, чужой кошелёк гейт ИИ не принимает; личный ИИ не задет.
KAREXO_FEATURES_TEAM_AI=
# Автоматизации баз («когда X - поставить Y»). off - вкладка прячет панель и не
# применяет правила; правила остаются в схеме базы. Замка на сервере нет: схема в op-логе.
KAREXO_FEATURES_DB_AUTOMATIONS=
# Mattermost и вебхук в «Интеграциях». off - подключение отвечает 403
# integration.disabled, рассылка и «Отправить в канал» канал пропускают, отключить можно
# всегда. Telegram, календари и GitHub не задеты.
KAREXO_FEATURES_MATTERMOST_WEBHOOK=

# Push-уведомления на устройства (Web Push и FCM). Пусто = умолчание редакции: в облаке включено,
# если заданы ключи Firebase или VAPID (ниже); на своём сервере выключено - нужны on И свои ключи.
# off выключает везде. Без ключей и без шлюза push выключен, что бы ни стояло здесь.
# В enterprise и при KAREXO_ALLOW_OUTBOUND=false FCM и Web Push закрыты всегда, push - только через
# KAREXO_PUSH_GATEWAY_URL (ниже). Строка реестра исходящих: docs/egress.md S19.
KAREXO_FEATURES_PUSH=
# Расшифровка голоса (запись уходит внешнему провайдеру речи по кнопке). Пусто = выключено.
# Без ключа SpeechKit (ниже) маршрут отвечает 503 voice.not_configured.
# В enterprise и без исходящих выключено ВСЕГДА. Строка реестра: docs/egress.md S20.
KAREXO_FEATURES_VOICE=
# Аналитика (решения владельца 23.10.2026, 152-ФЗ ст. 18 ч. 5 - данные в РФ): приложению Android -
# статистика и отчёты о сбоях в AppMetrica (уходят с телефона, docs/egress.md C7 и C8), веб-вкладке -
# Яндекс Метрика в изолированной рамке (нужен ещё KAREXO_METRIKA_COUNTER_ID ниже, S19c). Пусто =
# выключено. Включать ТОЛЬКО после того, как строка о передаче появилась в опубликованной политике
# ПДн: оболочка и вкладка дополнительно спрашивают явное согласие человека. В enterprise и без
# исходящих выключено ВСЕГДА.
KAREXO_FEATURES_APP_TELEMETRY=
# Карточка «Google» (календарь и Диск) в каталоге интеграций. Пусто = умолчание редакции:
# в облаке скрыта до одобрения приложения Google, на своём сервере видна. on/off выбирают.
# Вход через Google не задевает.
KAREXO_GOOGLE_CALENDAR=
# Шлюз push ЗАКАЗЧИКА (UnifiedPush / ntfy), адрес вида https://ntfy.example.com (http - только для
# своей сети). В enterprise и без исходящих это ЕДИНСТВЕННЫЙ путь push: без адреса он выключен.
# Нужен и KAREXO_FEATURES_PUSH=on. Уходит только категория уведомления, без содержимого.
# Негодный адрес (логин, запрос, метаданные облака, петля) - сервер не стартует.
# Строка реестра исходящих: docs/egress.md S19a.
KAREXO_PUSH_GATEWAY_URL=
# Ключи push (секреты, решение владельца 23.10.2026; строка реестра docs/egress.md S19).
# Firebase для оболочки Android: JSON сервисного аккаунта из консоли Firebase (Настройки проекта ->
# Сервисные аккаунты -> Создать закрытый ключ). Задаётся ОДНО из двух: путь к файлу внутри контейнера
# (положите файл в том данных, например /data/firebase-push.json) или само содержимое JSON одной
# строкой. Значения в журнал не попадают; негодный файл - сервер не стартует.
KAREXO_FCM_CREDENTIALS_FILE=
KAREXO_FCM_CREDENTIALS_JSON=
# Android App Links (29.10.2026): SHA-256 отпечаток сертификата подписи APK, как печатает
# `keytool -list -v` (AA:BB:...; несколько - через запятую). Задан - сервер отдаёт
# /.well-known/assetlinks.json для пакета pro.karexo.app и возвращает вход и подключения
# в приложение https-ссылкой <KAREXO_BASE_URL>/app/... (нужен https-адрес без пути), а не
# схемой karexo://, которую может перехватить чужое приложение. Пусто - файл 404, всё как
# раньше. Отпечаток - не секрет. Работает только для APK, подписанного этим ключом, и хоста,
# зашитого в его манифест (облако - app.karexo.pro; см. clients/android/README.md).
KAREXO_ANDROID_CERT_SHA256=
# Web Push для браузеров и PWA: пара ключей VAPID (base64url), например из
# `npx web-push generate-vapid-keys`. Публичный отдаётся браузеру в /api/policy, приватный - секрет.
# SUBJECT - контакт владельца для push-сервисов: mailto:адрес или https://адрес (обязателен с ключами).
# Пара не сходится или нет SUBJECT - сервер не стартует.
KAREXO_VAPID_PUBLIC_KEY=
KAREXO_VAPID_PRIVATE_KEY=
KAREXO_VAPID_SUBJECT=
# Номер счётчика Яндекс Метрики для веб-вкладки (только цифры, из metrika.yandex.ru; Вебвизор
# не включать). Действует только с KAREXO_FEATURES_APP_TELEMETRY=on: тогда страница рамки
# /metrika.html пускает tag.js и отправку на mc.yandex.ru и mc.yandex.com (окно приложения - никогда).
# Номер без ведущего нуля; кривое значение - сервер не стартует.
KAREXO_METRIKA_COUNTER_ID=
# Яндекс SpeechKit для расшифровки голоса (секрет). Нужен вместе с KAREXO_FEATURES_VOICE=on; пусто =
# голос не подключён (503 voice.not_configured). Идёт через KAREXO_OUTBOUND_PROXY, если он задан.
# Папка (каталог Yandex Cloud) для ключа сервисного аккаунта необязательна. Строка реестра: S20.
KAREXO_SPEECH_API_KEY=
KAREXO_SPEECH_FOLDER_ID=

# Потолок попыток ввода кода второго фактора: столько догадок на аккаунт за
# столько секунд. Пусто = 10 и 300.
#
# Пара одна на ОБА места, где спрашивают код: второй фактор в настройках и
# второй шаг входа через провайдера (у того, кому провайдер завёл аккаунт и у
# кого пароля нет вовсе). Действие одно и то же - «докажи владение шестизначным
# кодом», - и двух разных ответов на вопрос «сколько догадок в минуту» у
# инстанса быть не должно.
#
# Ключ - аккаунт, а не адрес, даже на входе: кого спрашивают, называет
# предбилет, выданный нами на возврате от провайдера. Счёт по адресу тут
# обходился бы сменой адреса, а запирал бы целый офис за общим NAT.
KAREXO_TOTP_MAX_ATTEMPTS=
KAREXO_TOTP_WINDOW_SEC=

# ─────────────────────────────────────────────────────────────────────────────
# Проверка обновлений
# ─────────────────────────────────────────────────────────────────────────────

# Раз в сутки инстанс спрашивает у GitHub, вышла ли новая версия, и показывает
# это администратору. Ничего не скачивает и не запускает сам - решение за вами.
# true - выключить совсем. В закрытом контуре проверка не работает и так:
# гаснет вместе с KAREXO_ALLOW_OUTBOUND.
KAREXO_UPDATES_OFF=

# Откуда брать список выпусков. Пусто = публичный репозиторий karexo.
KAREXO_UPDATES_REPO=

# Инстанс работает в контейнере. От этого зависит только подсказка: показать
# команду docker compose или запуск install.sh. В поставочном compose уже true.
KAREXO_IN_DOCKER=true

# ─────────────────────────────────────────────────────────────────────────────
# Лицензия
# ─────────────────────────────────────────────────────────────────────────────

# Ключ платной редакции: сам ключ строкой либо путь к файлу с ним.
# Проверяется ОФФЛАЙН - обращений наружу нет, в закрытом контуре работает так же.
# Пусто = бесплатная установка (self-hosted), всё основное доступно.
KAREXO_LICENSE=

# true - без действующего ключа инстанс не запустится вовсе.
# По умолчанию мягко: расхождение видно в логе и в /api/policy, работа идёт.
KAREXO_LICENSE_ENFORCE=
# Проверка лицензии: инстанс раз в сутки спрашивает, жив ли его ключ. Это
# единственный способ отозвать лицензию - проверка идёт оффлайн, и о нашем
# решении инстанс иначе не узнает никогда. Уходят два значения: номер ключа и
# имя установки, ничего больше (см. docs/egress.md, S13).
#
# По умолчанию включено ТОЛЬКО в self-hosted. В enterprise выключено навсегда и
# не включается ничем. false - лицензия живёт до конца срока, как обычный
# оффлайн-ключ.
KAREXO_LICENSE_CHECK=
# Свой шлюз проверки вместо нашего сервиса (для закрытого контура).
KAREXO_LICENSE_CHECK_URL=

# Спрашивать ли раз в сутки, вышла ли новая версия karexo. Новость видят только
# владелец и администратор инстанса - обновлять сервер всё равно им.
# По умолчанию включено ТОЛЬКО в self-hosted: в SaaS выключено навсегда (инстансы
# наши), в enterprise молчит вместе с остальными исходящими, но заказчик вправе
# включить. Ничего не скачивается и не запускается - только сообщаем.
KAREXO_UPDATES_CHECK=


# ─────────────────────────────────────────────────────────────────────────────
# Закрытый контур
# ─────────────────────────────────────────────────────────────────────────────

# false - сервер не обращается ни к одному внешнему адресу. То же самое даёт
# KAREXO_EDITION=enterprise. Проверить, в каком режиме инстанс поднялся:
#   curl <KAREXO_BASE_URL>/api/policy
KAREXO_ALLOW_OUTBOUND=

# Свои адреса вместо публичных: GitHub Enterprise Server на вашем домене,
# Slack и Telegram через внутренний прокси. Пусто = обычные адреса.
# GHES: задавайте ОБЕ переменные GITHUB_*_HOST. GHES до 3.23 принимает у
# OAuth App только один callback - впишите <KAREXO_BASE_URL>/api, он
# покрывает все четыре пути из списка выше.
KAREXO_GITHUB_AUTH_HOST=
KAREXO_GITHUB_API_HOST=
KAREXO_SLACK_HOOK_HOST=
KAREXO_TELEGRAM_API_HOST=

# Исходящий прокси ТОЛЬКО для запросов к ИИ и уведомлений в Telegram (сервер в РФ:
# провайдеры ИИ и Telegram оттуда закрыты). Схемы http, https, socks5, socks5h:
#   http://xray:10809   socks5h://xray:10808   http://логин:пароль@xray:10809
# Пусто = напрямую. Негодное значение останавливает старт. Прокси недоступен -
# запрос завершается ошибкой, на прямое соединение НЕ откатываемся.
# Остальные исходящие (ссылки, вебхуки, OAuth, оплата, почта) идут напрямую.
KAREXO_OUTBOUND_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# Приём платежей (только SaaS)
# ─────────────────────────────────────────────────────────────────────────────
# Ключи магазина ЮKassa. Без них оплата картой НЕ собирается вовсе: ручка
# отвечает отказом, а не ведёт человека в никуда.
#
# Работают только вместе с KAREXO_QUOTA_SOURCE=billing и разрешёнными
# исходящими - наружу ходит сервер (S12 в docs/egress.md). В редакции SaaS
# billing ставится сам: забытая переменная не должна отключать тарифы.
# Вне SaaS billing игнорируется, так что магазин там не нужен.
#
# Путь «по счёту» - администратор выдаёт подписку руками - работает и БЕЗ этих
# ключей: компания платит на расчётный счёт, тариф включает человек.
KAREXO_YOOKASSA_SHOP_ID=
KAREXO_YOOKASSA_SECRET=

# Что делать с ПРОСРОЧЕННЫМ тарифом: none | notify | freeze.
#
#   none    - просрочки не существует: ни полос, ни писем, ни замка;
#   notify  - предупреждаем (полоса, лента, письмо), но правку не отнимаем;
#   freeze  - полный сценарий: неделя предупреждения, две льготные недели,
#             после них правка и загрузка файлов приостанавливаются. Заметки
#             при этом читаются и выгружаются как прежде, а продление снимает
#             приостановку сразу - размораживать ничего не нужно.
#
# Пусто = умолчание редакции: saas - freeze, остальные - notify. Значение
# перебивает умолчание в обе стороны: администратор своего сервера, продающий
# места коллегам, обычно оставляет notify - запирать им правку грубее, чем нам
# клиентам облака.
#
# ВНЕ KAREXO_QUOTA_SOURCE=billing выключено всегда и не включается ничем: там,
# где тарифов нет, просрочивать нечего. Это второй предохранитель рядом с
# первым - подписка по договору не имеет срока, а без срока замка не бывает.
#
# `notify` - рычаг отката: он снимает ЗАМОК, не трогая предупреждений.
KAREXO_OVERDUE=

# Сколько дней выставленный счёт держит покупателю правку и тарифное место.
#
# Компания платит по безналу: счёт уходит бухгалтерии, деньги идут на расчётный
# счёт, а отметку «оплачен» ставит человек в админке - через день или через
# две недели. Всё это время заплативший клиент не должен сидеть под замком,
# поэтому выставленный счёт держит ему правку и место, как будто он платящий.
#
# Умолчание - 14 дней: банковский перевод с запасом на праздники. Отсчёт идёт от
# ВЫСТАВЛЕНИЯ счёта, а не от конца оплаченного периода.
#
# ⚠️ 0 СНИМАЕТ СРОК - поблажка становится бессрочной, как было до 07.09.2026
# (счёт держит, пока администратор его не аннулирует). Это рычаг отката без
# выкатки релиза, а НЕ выключатель поблажки: «поблажки не будет вовсе» этой
# переменной не выражается, и не должно - закрывать её поимённо администратор
# может аннулированием счёта.
#
# ⚠️ Истекает ТОЛЬКО поблажка. Сам счёт остаётся выставленным, его номер у
# покупателя, и отметка оплаты по-прежнему возвращает тариф.
KAREXO_OVERDUE_INVOICE_HOLD_DAYS=

# Ставка НДС в чеке 54-ФЗ: 1 - без НДС, 2 - 0%, 3 - 10%, 4 - 20%.
# Умолчание (1) - самая частая система у малого бизнеса: УСН, самозанятость.
# На общей системе поставьте свой код: ставка не угадывается, а неверный
# фискальный документ - это уже вопрос не к продукту.
KAREXO_YOOKASSA_VAT_CODE=

# ─────────────────────────────────────────────────────────────────────────────
# Продажа токенов karexo
# ─────────────────────────────────────────────────────────────────────────────

# true | false - продаёт ли инстанс токены karexo: человек платит нам, мы платим
# провайдеру AI. Работает только вместе с KAREXO_QUOTA_SOURCE=billing и
# KAREXO_AI_METERING=proxy - иначе списывать нечего, запрос уходит мимо нас.
#
# Пусто = умолчание редакции: в saas продаём, в остальных нет. Право лежит в
# ЭТОЙ строке, а не в KAREXO_EDITION, намеренно: редакцию инстанс объявляет о
# себе сам, и вписанное себе `saas` не должно открывать чужой платный контур.
KAREXO_AI_TOKEN_SALES=

# true | false - продаём ли ПАКЕТЫ кредитов: кнопка «Пополнить», покупка пакета
# и раздел «Номиналы кредитов» в консоли. Пусто = выключено во всех редакциях,
# в saas тоже (решение владельца P1-23): заведённый номинал сам продажу не
# включает. Действует только поверх продажи токенов (строка выше + billing +
# proxy). Кредиты тарифа не трогает.
KAREXO_CREDIT_PACK_SALES=

# Вправе ли человек ходить в модель СВОИМ ключом.
#
# Пусто = умолчание редакции: в saas нельзя (AI там только наш, решение
# владельца), в self-hosted и enterprise можно - человек выбирает, ключ инстанса
# или свой, и во втором случае ему открыты настройки адреса и модели.
#
# false тут - настоящий запрет, а не спрятанное поле в интерфейсе: прокси
# ОТВЕРГАЕТ запрос, в котором принесли свой ключ (ai.own_key_forbidden). И он же
# включает счёт расхода: раз токены наши, их надо считать (KAREXO_AI_METERING
# получает proxy, если явно не сказано иное).
KAREXO_AI_OWN_KEY=

# Ключ инстанса: им прокси ходит в модель ЗА СЧЁТ ИНСТАНСА.
#
# Обязателен там, где свой ключ пользователя запрещён (см. выше): без него
# ходить в модель нечем, и AI на инстансе просто не работает. Где свой ключ
# разрешён - запасной: им пользуются те, кто своего не вписал.
#
# СЕКРЕТ. Ни в журнал, ни клиенту не уезжает никогда - только в исходящий
# запрос к провайдеру. Адрес и ключ ездят парой: адрес пользователя с ключом
# инстанса не смешиваются, иначе ключ уехал бы на чужой сервер.
#
# Пример для YandexGPT: BASE_URL=https://llm.api.cloud.yandex.net/v1,
# AUTH=api-key. Пусто в AUTH = Bearer.
KAREXO_AI_BASE_URL=
KAREXO_AI_API_KEY=
KAREXO_AI_AUTH=

# Список моделей ИИ, который задаёт СЕРВЕР: ключ=идентификатор;ключ=идентификатор
# Первая запись - модель по умолчанию, порядок = порядок показа. Человек видит
# только ключи (fast, smart), а folder id и идентификаторы провайдера вписываются
# прямо в значение и остаются на сервере. Чат принимает ТОЛЬКО ключ из списка,
# сырой идентификатор отвергается (ai.model_unknown), а каталог провайдера не
# запрашивается. Ключ: [a-z][a-z0-9_-]{0,31}; не более 8 записей; эмбеддинги,
# речь, rc и deprecated отвергаются при старте.
# Пусто = как раньше. Для SaaS рекомендуется: без этого человек видит сырой каталог.
# Пример: fast=gpt://<folder-id>/yandexgpt-lite/latest;smart=gpt://<folder-id>/yandexgpt/latest
KAREXO_AI_MODELS=

# Месячный предел расхода КЛЮЧОМ ИНСТАНСА на человека: токены и запросы за
# календарный месяц UTC.
#
# Зачем. Ключом инстанса ходит всякий вошедший, кто не вписал своего, а
# регистрация по умолчанию открыта - то есть «всякий вошедший» означает любого
# человека из интернета. Предел бережёт ключ организации.
#
# ⚠️ НОЛЬ СНИМАЕТ ПРЕДЕЛ - как у KAREXO_EGRESS_MONTHLY_BYTES, а НЕ «действует
# умолчание», как у KAREXO_BLOB_MAX_SIZE. Пусто и 0 здесь одно и то же.
#
# Считается расход ВСЕГДА, ещё до того как число задано: иначе первый же
# назначенный завтра предел начал бы счёт с нуля посреди месяца. Два числа
# обязательны оба: токены присылает не всякий провайдер, и счёт по одним
# токенам молча стоял бы на нуле.
KAREXO_AI_INSTANCE_TOKENS_MONTHLY=
KAREXO_AI_INSTANCE_REQUESTS_MONTHLY=
#
# Потолок НА ВЕСЬ СЕРВЕР - сумма всех людей вместе за тот же месяц.
# ⚠️ Счёт от провайдера закрывает именно он: счёт приходит один на сервер, а
# пара выше считает НА ЧЕЛОВЕКА и умножается на количество людей. Отказ по этому
# потолку приходит всем, включая администратора.
# 0 и пусто - потолка нет, как и у пары выше.
KAREXO_AI_INSTANCE_TOKENS_MONTHLY_TOTAL=
KAREXO_AI_INSTANCE_REQUESTS_MONTHLY_TOTAL=
#
# Сколько СЕКУНД ждём весь потоковый ответ модели, от отправки до последнего
# байта. Пусто - 300 (пять минут).
# ⚠️ Это НЕ предел расхода, а срок ожидания. Мало - и длинный ответ рвётся на
# середине вместе с финальным чанком, где приезжают счётчики токенов: расход
# спишется нулевой, а токены у провайдера сгорят.
# Ноль и мусор читаются как умолчание: выключить потолок нельзя, иначе молчащий
# провайдер держал бы горутину и сокет навсегда.
KAREXO_AI_STREAM_TIMEOUT_SEC=

# ─────────────────────────────────────────────────────────────────────────────
# Дверь консоли владельца продукта - НЕ ВАША
# ─────────────────────────────────────────────────────────────────────────────
# Консоль владельца продукта - наш внутренний инструмент, вам он не поставляется.
# В вашей установке эта дверь НЕ ОТКРЫВАЕТСЯ ВОВСЕ: она живёт только в облачной
# редакции. Строки стоят здесь затем, чтобы переменная, которую читает сервер,
# была видна и объяснена, а не встречалась в логе как загадка.
#
# Оставьте пустыми.
KAREXO_CONSOLE_TOKEN=
KAREXO_CONSOLE_ACTOR=
